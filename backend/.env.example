# E-Commerce Website Environment Configuration

PROJECT_NAME=E-Commerce Website
ENV=development
DEBUG=True

# Security
SECRET_KEY=shopsphere_super_secret_jwt_key_change_in_production_983742918347
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Primary target is MySQL 8+:
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/shopsphere_db
# For zero-config local testing/running when MySQL server is not active:
DATABASE_URL=sqlite:///./shopsphere.db

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Admin Initial Credentials for Seeding
DEFAULT_ADMIN_EMAIL=admin@shopsphere.com
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_ADMIN_NAME=Admin User
DEFAULT_ADMIN_PHONE=9876543210

# AI Chatbot (Google Gemini API via Google AI Studio)
GEMINI_API_KEY=your_actual_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

